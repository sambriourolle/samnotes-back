      "validate": {
        "id": "validate",
        "code": "const p = context.parameters;\nif (!context.auth?.isAuthenticated) return {ok:false,status:401,error:'Connexion requise.'};\nif (!['create','save','archive','restore'].includes(p.operation)) return {ok:false,status:400,error:'Opération invalide.'};\nif (p.operation !== 'create' && (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(p.noteId || '') || !Number.isInteger(p.revision) || p.revision < 0)) return {ok:false,status:400,error:'Identifiant ou version invalide.'};\nif (['create','save'].includes(p.operation) && (typeof p.title !== 'string' || !p.title.trim() || p.title.trim().length > 180 || typeof p.markdown !== 'string' || p.markdown.length > 1000000)) return {ok:false,status:400,error:'Titre requis (180 caractères maximum), contenu limité à 1 million de caractères.'};\n// Write a new file so concurrent requests cannot overwrite each other's content.\nreturn {ok:true,title:(p.title || '').trim(),path:'notes/versions/' + Date.now() + '-' + Math.random().toString(36).slice(2) + '-' + Math.random().toString(36).slice(2) + '.md'};",
        "name": "Valider",
        "next": "valid",
